@inproceedings{vecchio_midgard_2024,
	address = {Cham},
	title = {{MIDGARD}: {A} {Robot} {Navigation} {Simulator} for {Outdoor} {Unstructured} {Environments}},
	isbn = {978-3-031-76424-0},
	shorttitle = {{MIDGARD}},
	doi = {10.1007/978-3-031-76424-0_22},
	abstract = {We present MIDGARD, a simulation platform based on Unreal Engine for training autonomous robots in complex outdoor unstructured environments. It offers photorealistic 3D scenes, procedural scene generation, and integration with ROS and OpenAI Gym. The focus of MIDGARD is on navigation, where an autonomous agent travels from random initial positions to designated target locations avoiding obstacles, enabling researchers to develop and evaluate novel algorithms and navigation methods. We evaluate MIDGARD’s suitability as a research tool by training navigation algorithms based on reinforcement learning; we also assess sim-to-real transfer capabilities in a traversable horizon prediction task, using deep learning models on RGB images only.},
	language = {en},
	booktitle = {European {Robotics} {Forum} 2024},
	publisher = {Springer Nature Switzerland},
	author = {Vecchio, Giuseppe and Sarpietro, Riccardo E. and Cancelliere, Francesco and Palazzo, Simone and Guastella, Dario C. and Strano, Alessandro and Carlucho, Ignacio and Muscato, Giovanni and Albrecht, Stefano V. and Spampinato, Concetto},
	editor = {Secchi, Cristian and Marconi, Lorenzo},
	year = {2024},
	keywords = {robot navigation, simulation, unstructured environments},
	pages = {120--125},
  selected = true,
}

@inproceedings{ishaq_quantitative_2025,
	title = {A {Quantitative} {Review} of {Smart} {Walkers}: {Trends}, {Gaps}, and a {Proposed} {Evaluation} {Framework}},
	shorttitle = {A {Quantitative} {Review} of {Smart} {Walkers}},
	url = {https://ieeexplore.ieee.org/abstract/document/11260711},
	doi = {10.1109/SIELMEN67352.2025.11260711},
	abstract = {Smart walkers represent a promising technology to enhance mobility and safety for the growing elderly population. However, the field faces challenges related to real-world performance, user acceptance, and a lack of standardized evaluation methods. This paper addresses these issues by conducting a quantitative review of 47 recent articles (2020–2025) to identify technological trends, application focuses, and research gaps. This review reveals a prevalence of systems using Inertial Measurement Units and Force Sensing Resistors for gait analysis and fall detection, with a growing adoption of machine learning for intelligent control. Yet, advanced navigation and perception technologies like LiDAR remain rare, and a significant gap persists between laboratory prototypes and robust, user-friendly commercial products. To foster more rigorous and comparable research, we propose a minimal common evaluation framework integrating technical performance metrics, standardized usability scales, and clinically relevant functional outcomes. Finally, we reformulate future challenges into concrete technical objectives related to real-world validation, cognitive load reduction, hardware efficiency, and personalized assistance. This structured approach, a result of a multidisciplinary synthesis, aims to guide the development of more effective, adoptable, and impactful smart walkers.},
	urldate = {2026-01-08},
	booktitle = {2025 {International} {Conference} on {Electromechanical} and {Energy} {Systems} ({SIELMEN})},
	author = {Ishaq, Muhammad and Guastella, Dario Calgero and Sutera, Giuseppe and Cancelliere, Francesco and Muscato, Giovanni},
	month = oct,
	year = {2025},
	keywords = {Assistive Robotics, Elderly Mobility, Evaluation Framework, Fall Prevention, Quantitative Review, Smart Walkers},
	pages = {377--382},
	file = {Full Text PDF:files/119/Ishaq et al. - 2025 - A Quantitative Review of Smart Walkers Trends, Gaps, and a Proposed Evaluation Framework.pdf:application/pdf},
}

@misc{chen_verti-arena_2025,
	title = {Verti-{Arena}: {A} {Controllable} and {Standardized} {Indoor} {Testbed} for {Multi}-{Terrain} {Off}-{Road} {Autonomy}},
	shorttitle = {Verti-{Arena}},
	url = {http://arxiv.org/abs/2508.08226},
	doi = {10.48550/arXiv.2508.08226},
	abstract = {Off-road navigation is an important capability for mobile robots deployed in environments that are inaccessible or dangerous to humans, such as disaster response or planetary exploration. Progress is limited due to the lack of a controllable and standardized real-world testbed for systematic data collection and validation. To fill this gap, we introduce Verti-Arena, a reconfigurable indoor facility designed specifically for off-road autonomy. By providing a repeatable benchmark environment, Verti-Arena supports reproducible experiments across a variety of vertically challenging terrains and provides precise ground truth measurements through onboard sensors and a motion capture system. Verti-Arena also supports consistent data collection and comparative evaluation of algorithms in off-road autonomy research. We also develop a web-based interface that enables research groups worldwide to remotely conduct standardized off-road autonomy experiments on Verti-Arena.},
	urldate = {2026-01-08},
	publisher = {arXiv},
	author = {Chen, Haiyue and Datar, Aniket and Xu, Tong and Cancelliere, Francesco and Rangwala, Harsh and Rao, Madhan Balaji and Song, Daeun and Eichinger, David and Xiao, Xuesu},
	month = nov,
	year = {2025},
	note = {arXiv:2508.08226 [cs]},
	keywords = {Computer Science - Robotics},
	file = {Preprint PDF:files/124/Chen et al. - 2025 - Verti-Arena A Controllable and Standardized Indoor Testbed for Multi-Terrain Off-Road Autonomy.pdf:application/pdf;Snapshot:files/123/2508.html:text/html},
}

@inproceedings{palazzo_learning-based_2024,
	address = {Cham},
	title = {Learning-{Based} {Ground} {Vehicle} {Navigation} in {Outdoor} {Unstructured} {Environments}},
	isbn = {978-3-031-76424-0},
	doi = {10.1007/978-3-031-76424-0_37},
	abstract = {Autonomous navigation in outdoor unstructured environments is still an open challenge in field robotics, due in part to the difficulty to recognize and evaluate distances from obstacles and to identify type and slope of terrain. We present our current research on autonomous ground robot navigation in outdoor environments. Lying at the intersection of robotics and artificial intelligence, we investigate vision-based methods, integrating unsupervised learning and domain adaptation techniques, for improved sim-to-real capabilities. We validate the proposed methods with on-field experiments on real unmanned ground vehicles, thus assessing the feasibility of the developed navigation methods.},
	language = {en},
	booktitle = {European {Robotics} {Forum} 2024},
	publisher = {Springer Nature Switzerland},
	author = {Palazzo, Simone and Guastella, Dario C. and Vecchio, Giuseppe and Sarpietro, Riccardo E. and Sutera, Giuseppe and Cancelliere, Francesco and Muscato, Giovanni and Spampinato, Concetto},
	editor = {Secchi, Cristian and Marconi, Lorenzo},
	year = {2024},
	keywords = {deep learning, domain adaptation, ground robot navigation, unstructured environments},
	pages = {207--211},
}
